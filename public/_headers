# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

# All responses: hint AI tools about markdown content
/*
  Link: </llms.txt>; rel="alternate"; type="text/markdown", </llms-full.txt>; rel="alternate"; type="text/markdown"
  X-Robots-Tag: all

# Serve llms files with correct content type
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400

# Static assets: long cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
